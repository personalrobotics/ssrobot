{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.RuntimeInfo v4",
  "$ref": "#/$defs/RuntimeInfo",
  "$defs": {
    "ChannelSpec": {
      "type": "object",
      "description": "A declared observation channel.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Channel name, unique within the robot."
        },
        "quantity": {
          "type": "string",
          "enum": [
            "joint_position",
            "joint_velocity",
            "joint_effort",
            "gripper_opening",
            "pose",
            "wrench",
            "rgb_image",
            "depth_image",
            "contact"
          ],
          "description": "What the channel measures."
        },
        "source": {
          "type": "string",
          "description": "Observed entity: a joint group (joint quantities), a gripper (opening), a frame (pose), a force-torque sensor (wrench), a camera (images), or, for a runtime's scene channels, a scene object (pose) or one entity of a contact."
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference frame a pose is expressed in; pose only."
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Reading shape.",
          "x-unit": "count"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "uint8",
            "uint16",
            "int32",
            "float32",
            "float64"
          ],
          "description": "Element type."
        },
        "privileged": {
          "type": "boolean",
          "description": "Simulator truth a real robot could not supply, such as an object's true pose; false for what a robot's own sensors provide."
        },
        "counterpart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The second entity of a contact channel; contact only."
        }
      },
      "required": [
        "name",
        "quantity",
        "source",
        "shape",
        "dtype"
      ],
      "additionalProperties": false
    },
    "CommandCapability": {
      "type": "object",
      "description": "A command a component accepts.",
      "properties": {
        "component": {
          "type": "string",
          "description": "Component name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "joint",
            "joint_trajectory",
            "gripper",
            "base_twist"
          ],
          "description": "Accepted command kind."
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "position",
                "velocity",
                "effort"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Joint mode; JOINT kind only."
        }
      },
      "required": [
        "component",
        "kind"
      ],
      "additionalProperties": false
    },
    "GuardCapability": {
      "type": "object",
      "description": "Guarded trajectories a runtime executes for one component, and the timing it",
      "properties": {
        "component": {
          "type": "string",
          "description": "The joint group whose trajectories may be guarded."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wrench channels a guard may read, sorted."
        },
        "tare": {
          "type": "boolean",
          "description": "Whether it measures from the reading at the start."
        },
        "period_ns": {
          "type": "integer",
          "description": "Time between guard evaluations.",
          "x-unit": "ns"
        },
        "stop_latency_ns": {
          "type": "integer",
          "description": "Longest time from a triggering reading to the hold.",
          "x-unit": "ns"
        }
      },
      "required": [
        "component",
        "channels",
        "tare",
        "period_ns",
        "stop_latency_ns"
      ],
      "additionalProperties": false
    },
    "RuntimeInfo": {
      "type": "object",
      "description": "What an opened runtime reports about itself.",
      "properties": {
        "schema": {
          "const": "ssrobot.RuntimeInfo"
        },
        "version": {
          "const": 4
        },
        "runtime": {
          "type": "string",
          "description": "Runtime implementation name."
        },
        "runtime_version": {
          "type": "string",
          "description": "Runtime implementation and backend versions."
        },
        "clock_mode": {
          "type": "string",
          "enum": [
            "manual",
            "external"
          ],
          "description": "Who advances time."
        },
        "clock": {
          "type": "string",
          "description": "Clock identity used by every timestamp it produces."
        },
        "description": {
          "type": "string",
          "description": "Fingerprint of the bound robot description."
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandCapability"
          },
          "description": "Command capabilities confirmed available now."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Channel names confirmed available now."
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scene objects that can be attached, sorted; empty without a scene."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Static scene bodies an attachment may allow contact with, sorted."
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrajectoryContract"
            },
            {
              "type": "null"
            }
          ],
          "description": "How it executes a JointTrajectory; None if it declares no contract, so timed plans cannot be compiled for it."
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuardCapability"
          },
          "description": "Per component, which force-torque guards it evaluates and how fast it stops, sorted by component; empty if it cannot execute a GuardedJointTrajectory."
        },
        "scene_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "description": "Channels the runtime declares for its scene, such as each object's pose and each contact pair asked for; their names are also in channels."
        },
        "privileged": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every confirmed channel, the robot's or the scene's, that is privileged simulator truth, sorted."
        }
      },
      "required": [
        "schema",
        "version",
        "runtime",
        "runtime_version",
        "clock_mode",
        "clock",
        "description",
        "commands",
        "channels"
      ],
      "additionalProperties": false
    },
    "TrajectoryContract": {
      "type": "object",
      "description": "How a runtime executes a ``JointTrajectory``: the trajectory-execution contract a",
      "properties": {
        "period_ns": {
          "type": "integer",
          "description": "Time between waypoints.",
          "x-unit": "ns"
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear"
          ],
          "description": "How the runtime moves between waypoints."
        },
        "fixed_period": {
          "type": "boolean",
          "description": "Whether the period holds for the lifetime of the context."
        }
      },
      "required": [
        "period_ns",
        "interpolation",
        "fixed_period"
      ],
      "additionalProperties": false
    }
  }
}
