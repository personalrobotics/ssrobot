{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.SceneState v2",
  "$ref": "#/$defs/SceneState",
  "$defs": {
    "Attachment": {
      "type": "object",
      "description": "A scene object declared held by an end effector.",
      "properties": {
        "object": {
          "type": "string",
          "description": "The held scene object."
        },
        "end_effector": {
          "type": "string",
          "description": "The end effector holding it."
        },
        "transform": {
          "$ref": "#/$defs/Pose",
          "description": "The object's pose in the end effector's frame."
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Robot frames and scene fixtures the object may touch, sorted."
        },
        "held": {
          "type": "boolean",
          "description": "False once the runtime reported the object left the grasp."
        }
      },
      "required": [
        "object",
        "end_effector",
        "transform",
        "allow"
      ],
      "additionalProperties": false
    },
    "Pose": {
      "type": "object",
      "description": "A rigid transform: the pose of a child frame expressed in a parent frame.",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Child origin in parent coordinates.",
          "x-unit": "m"
        },
        "quat_wxyz": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "Unit quaternion (w, x, y, z) rotating child axes into parent.",
          "x-unit": "1"
        }
      },
      "required": [
        "position",
        "quat_wxyz"
      ],
      "additionalProperties": false
    },
    "Registration": {
      "type": "object",
      "description": "An object's pose, as a registration source reported it.",
      "properties": {
        "object": {
          "type": "string",
          "description": "The scene object."
        },
        "pose": {
          "$ref": "#/$defs/Pose",
          "description": "Its pose in the world frame."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the pose was observed, on the runtime clock."
        },
        "source": {
          "type": "string",
          "description": "What reported it, as an identifier."
        }
      },
      "required": [
        "object",
        "pose",
        "stamp",
        "source"
      ],
      "additionalProperties": false
    },
    "SceneState": {
      "type": "object",
      "description": "A context's scene: the objects it can hold and what it holds now.",
      "properties": {
        "schema": {
          "const": "ssrobot.SceneState"
        },
        "version": {
          "const": 2
        },
        "revision": {
          "type": "integer",
          "description": "Increments on every change, from 0 when the context opens.",
          "x-unit": "count"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scene objects that can be attached, sorted."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Static scene bodies an attachment may allow contact with, sorted."
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "description": "Current attachments, sorted by object."
        },
        "object_poses": {
          "type": "string",
          "enum": [
            "live",
            "registered"
          ],
          "description": "Where snapshots take object poses from."
        },
        "registrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Registration"
          },
          "description": "Each registered free object's last registration, sorted by object."
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Objects explicitly removed from the active scene, sorted."
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "objects",
        "fixtures"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "object",
      "description": "A point in time on a named clock.",
      "properties": {
        "clock": {
          "type": "string",
          "description": "Clock identity, e.g. 'sim:geodude-1' or 'ros:/clock'."
        },
        "time_ns": {
          "type": "integer",
          "description": "Nanoseconds since the clock's epoch.",
          "x-unit": "ns"
        }
      },
      "required": [
        "clock",
        "time_ns"
      ],
      "additionalProperties": false
    }
  }
}
