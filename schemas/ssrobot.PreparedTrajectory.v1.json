{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.PreparedTrajectory v1",
  "$ref": "#/$defs/PreparedTrajectory",
  "$defs": {
    "ExecutionCheck": {
      "type": "object",
      "description": "One independent check of a runtime command.",
      "properties": {
        "name": {
          "type": "string",
          "description": "What was checked."
        },
        "passed": {
          "type": "boolean",
          "description": "Whether the command satisfies it."
        },
        "detail": {
          "type": "string",
          "description": "The worst case found, with its bound."
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "additionalProperties": false
    },
    "JointTrajectory": {
      "type": "object",
      "description": "Timed joint positions for a group, executed from the time it starts.",
      "properties": {
        "schema": {
          "const": "ssrobot.JointTrajectory"
        },
        "version": {
          "const": 1
        },
        "group": {
          "type": "string",
          "description": "Joint group name."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names; must equal the group's order."
        },
        "time_from_start_ns": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Waypoint times; start at 0 and strictly increase.",
          "x-unit": "ns"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "One row of joint positions per waypoint.",
          "x-unit": "joint"
        },
        "velocities": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional row of joint velocities per waypoint.",
          "x-unit": "joint/s"
        }
      },
      "required": [
        "schema",
        "version",
        "group",
        "joints",
        "time_from_start_ns",
        "positions"
      ],
      "additionalProperties": false
    },
    "PreparedTrajectory": {
      "type": "object",
      "description": "A runtime command sampled from a timed trajectory, with the independent checks it",
      "properties": {
        "schema": {
          "const": "ssrobot.PreparedTrajectory"
        },
        "version": {
          "const": 1
        },
        "request": {
          "type": "string",
          "description": "Fingerprint of the request it was planned for."
        },
        "source": {
          "type": "string",
          "description": "Fingerprint of the timed trajectory it samples."
        },
        "source_law": {
          "type": "string",
          "enum": [
            "piecewise_constant_acceleration"
          ],
          "description": "The source trajectory's law."
        },
        "period_ns": {
          "type": "integer",
          "description": "The sampling period.",
          "x-unit": "ns"
        },
        "runtime_interpolation": {
          "type": "string",
          "enum": [
            "linear"
          ],
          "description": "How the runtime moves between the command's waypoints."
        },
        "command": {
          "$ref": "#/$defs/JointTrajectory",
          "description": "The command to submit."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutionCheck"
          },
          "description": "Every check, all passed."
        }
      },
      "required": [
        "schema",
        "version",
        "request",
        "source",
        "source_law",
        "period_ns",
        "runtime_interpolation",
        "command",
        "checks"
      ],
      "additionalProperties": false
    }
  }
}
