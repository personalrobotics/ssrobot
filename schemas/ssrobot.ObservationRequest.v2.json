{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.ObservationRequest v2",
  "$ref": "#/$defs/ObservationRequest",
  "$defs": {
    "ObservationRequest": {
      "type": "object",
      "description": "Channels a client wants in each observation.",
      "properties": {
        "schema": {
          "const": "ssrobot.ObservationRequest"
        },
        "version": {
          "const": 2
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Requested channel names."
        },
        "portable_only": {
          "type": "boolean",
          "description": "Refuse privileged channels: ask only for what a real robot supplies."
        }
      },
      "required": [
        "schema",
        "version",
        "channels"
      ],
      "additionalProperties": false
    }
  }
}
