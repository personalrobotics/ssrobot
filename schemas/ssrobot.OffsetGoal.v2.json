{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.OffsetGoal v2",
  "$ref": "#/$defs/OffsetGoal",
  "$defs": {
    "OffsetGoal": {
      "type": "object",
      "description": "Move the request's frame in a straight line: ``distance`` along ``direction`` in",
      "properties": {
        "schema": {
          "const": "ssrobot.OffsetGoal"
        },
        "version": {
          "const": 2
        },
        "direction": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Unit direction of motion in the world.",
          "x-unit": "1"
        },
        "distance": {
          "type": "number",
          "description": "How far to move.",
          "x-unit": "m"
        },
        "position_tolerance": {
          "type": "number",
          "description": "Allowed distance from the line and the goal.",
          "x-unit": "m"
        },
        "rotation_tolerance": {
          "type": "number",
          "description": "Allowed rotation from the reference orientation, per axis.",
          "x-unit": "rad"
        },
        "reference_pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pose"
            },
            {
              "type": "null"
            }
          ],
          "description": "World pose of the constrained frame at zero distance: its position anchors the line, its orientation is the one kept. None: the frame's pose at the request's start."
        }
      },
      "required": [
        "schema",
        "version",
        "direction",
        "distance",
        "position_tolerance",
        "rotation_tolerance"
      ],
      "additionalProperties": false
    },
    "Pose": {
      "type": "object",
      "description": "A rigid transform: the pose of a child frame expressed in a parent frame.",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Child origin in parent coordinates.",
          "x-unit": "m"
        },
        "quat_wxyz": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "Unit quaternion (w, x, y, z) rotating child axes into parent.",
          "x-unit": "1"
        }
      },
      "required": [
        "position",
        "quat_wxyz"
      ],
      "additionalProperties": false
    }
  }
}
