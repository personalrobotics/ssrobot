{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.ExecutionStatus v2",
  "$ref": "#/$defs/ExecutionStatus",
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "description": "Why something was rejected, failed, or modified.",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable machine-readable code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected component, if any."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ExecutionStatus": {
      "type": "object",
      "description": "The state of one submitted command at a point in runtime time.",
      "properties": {
        "schema": {
          "const": "ssrobot.ExecutionStatus"
        },
        "version": {
          "const": 2
        },
        "execution": {
          "type": "string",
          "description": "Execution identifier, unique within a context."
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "succeeded",
            "canceled",
            "timed_out",
            "rejected",
            "failed"
          ],
          "description": "Current state."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When this state was observed."
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostic"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for rejected, timed-out, and failed states."
        },
        "guard": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuardOutcome"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a guarded trajectory ended; on its succeeded status only."
        }
      },
      "required": [
        "schema",
        "version",
        "execution",
        "state",
        "stamp"
      ],
      "additionalProperties": false
    },
    "GuardOutcome": {
      "type": "object",
      "description": "How a ``GuardedJointTrajectory`` ended, with the evidence for it.",
      "properties": {
        "cause": {
          "type": "string",
          "enum": [
            "guard_triggered",
            "trajectory_completed"
          ],
          "description": "Why it ended."
        },
        "elapsed_ns": {
          "type": "integer",
          "description": "Time since the trajectory started when it ended.",
          "x-unit": "ns"
        },
        "part": {
          "type": "string",
          "enum": [
            "force",
            "torque"
          ],
          "description": "Which half of the wrench was measured."
        },
        "measure": {
          "type": "number",
          "description": "The guarded measure at the deciding tick.",
          "x-unit-by": {
            "field": "part",
            "units": {
              "force": "N",
              "torque": "N*m"
            }
          }
        },
        "wrench": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The wrench read at the deciding tick, untared.",
          "x-unit": "channel"
        }
      },
      "required": [
        "cause",
        "elapsed_ns",
        "part",
        "measure",
        "wrench"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "part": {
                "const": "force"
              }
            },
            "required": [
              "part"
            ]
          },
          "then": {
            "properties": {
              "measure": {
                "x-unit": "N"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "part": {
                "const": "torque"
              }
            },
            "required": [
              "part"
            ]
          },
          "then": {
            "properties": {
              "measure": {
                "x-unit": "N*m"
              }
            }
          }
        }
      ]
    },
    "Timestamp": {
      "type": "object",
      "description": "A point in time on a named clock.",
      "properties": {
        "clock": {
          "type": "string",
          "description": "Clock identity, e.g. 'sim:geodude-1' or 'ros:/clock'."
        },
        "time_ns": {
          "type": "integer",
          "description": "Nanoseconds since the clock's epoch.",
          "x-unit": "ns"
        }
      },
      "required": [
        "clock",
        "time_ns"
      ],
      "additionalProperties": false
    }
  }
}
