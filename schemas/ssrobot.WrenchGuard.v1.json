{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.WrenchGuard v1",
  "$ref": "#/$defs/WrenchGuard",
  "$defs": {
    "WrenchGuard": {
      "type": "object",
      "description": "A force-torque condition a runtime evaluates at every control tick.",
      "properties": {
        "schema": {
          "const": "ssrobot.WrenchGuard"
        },
        "version": {
          "const": 1
        },
        "channel": {
          "type": "string",
          "description": "The wrench channel it reads."
        },
        "part": {
          "type": "string",
          "enum": [
            "force",
            "torque"
          ],
          "description": "Force or torque."
        },
        "axis": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ],
          "description": "Unit axis in the sensor frame to project onto; None for the magnitude.",
          "x-unit": "1"
        },
        "threshold": {
          "type": "number",
          "description": "Trigger when the measure reaches this.",
          "x-unit-by": {
            "field": "part",
            "units": {
              "force": "N",
              "torque": "N*m"
            }
          }
        },
        "tare": {
          "type": "boolean",
          "description": "Measure from the reading when the motion started."
        },
        "samples": {
          "type": "integer",
          "description": "Consecutive ticks at or over the threshold.",
          "x-unit": "count"
        }
      },
      "required": [
        "schema",
        "version",
        "channel",
        "part",
        "threshold"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "part": {
                "const": "force"
              }
            },
            "required": [
              "part"
            ]
          },
          "then": {
            "properties": {
              "threshold": {
                "x-unit": "N"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "part": {
                "const": "torque"
              }
            },
            "required": [
              "part"
            ]
          },
          "then": {
            "properties": {
              "threshold": {
                "x-unit": "N*m"
              }
            }
          }
        }
      ]
    }
  }
}
