{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.package v1",
  "$ref": "#/$defs/PackageManifest",
  "$defs": {
    "CandidateChoice": {
      "type": "object",
      "description": "CandidateChoice(*, candidate: 'str', name: 'str')",
      "properties": {
        "candidate": {
          "type": "string",
          "description": "Candidate identifier from the inference report."
        },
        "name": {
          "type": "string",
          "description": "Name of the entities the candidate becomes."
        }
      },
      "required": [
        "candidate",
        "name"
      ],
      "additionalProperties": false
    },
    "ChannelSpec": {
      "type": "object",
      "description": "A declared observation channel.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Channel name, unique within the robot."
        },
        "quantity": {
          "type": "string",
          "enum": [
            "joint_position",
            "joint_velocity",
            "joint_effort",
            "gripper_opening",
            "pose",
            "wrench",
            "rgb_image",
            "depth_image"
          ],
          "description": "What the channel measures."
        },
        "source": {
          "type": "string",
          "description": "Observed entity: a joint group (joint quantities), a gripper (opening), a frame (pose), a force-torque sensor (wrench), or a camera (images)."
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference frame a pose is expressed in; pose only."
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Reading shape.",
          "x-unit": "count"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "uint8",
            "uint16",
            "int32",
            "float32",
            "float64"
          ],
          "description": "Element type."
        }
      },
      "required": [
        "name",
        "quantity",
        "source",
        "shape",
        "dtype"
      ],
      "additionalProperties": false
    },
    "CollisionAllowance": {
      "type": "object",
      "description": "A pair of frames whose geometry is never checked against each other by default.",
      "properties": {
        "frame_a": {
          "type": "string",
          "description": "The lexicographically smaller frame."
        },
        "frame_b": {
          "type": "string",
          "description": "The lexicographically larger frame."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque provenance, e.g. SRDF's 'Adjacent'."
        }
      },
      "required": [
        "frame_a",
        "frame_b"
      ],
      "additionalProperties": false
    },
    "CommandCapability": {
      "type": "object",
      "description": "A command a component accepts.",
      "properties": {
        "component": {
          "type": "string",
          "description": "Component name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "joint",
            "joint_trajectory",
            "gripper",
            "base_twist"
          ],
          "description": "Accepted command kind."
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "position",
                "velocity",
                "effort"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Joint mode; JOINT kind only."
        }
      },
      "required": [
        "component",
        "kind"
      ],
      "additionalProperties": false
    },
    "EndEffector": {
      "type": "object",
      "description": "What a manipulator acts through. Without a gripper it is a tool, such as a fork.",
      "properties": {
        "name": {
          "type": "string",
          "description": "End-effector name, unique within the robot."
        },
        "frame": {
          "type": "string",
          "description": "Tool center point frame."
        },
        "gripper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gripper that actuates it, if any."
        }
      },
      "required": [
        "name",
        "frame"
      ],
      "additionalProperties": false
    },
    "FileEntry": {
      "type": "object",
      "description": "FileEntry(*, name: 'str', path: 'str')",
      "properties": {
        "name": {
          "type": "string",
          "description": "Entry name, unique within its list."
        },
        "path": {
          "type": "string",
          "description": "File path relative to the package root."
        }
      },
      "required": [
        "name",
        "path"
      ],
      "additionalProperties": false
    },
    "Gripper": {
      "type": "object",
      "description": "An actuated grasping device, commanded by opening.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Component name, unique among components."
        },
        "frame": {
          "type": "string",
          "description": "Frame the gripper is mounted at."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joints the gripper moves, including passive linkage joints."
        }
      },
      "required": [
        "name",
        "frame"
      ],
      "additionalProperties": false
    },
    "InferenceSettings": {
      "type": "object",
      "description": "The ``[inference]`` table of a package manifest.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "report",
            "adopt"
          ],
          "description": "Whether to adopt unambiguous candidates."
        },
        "confirm": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateChoice"
          },
          "description": "Candidates to adopt, with their names."
        },
        "reject": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Candidates never to adopt."
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "JointGroup": {
      "type": "object",
      "description": "An ordered set of joints commanded and observed together.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Component name, unique among components."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names in canonical order."
        },
        "subgroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Groups this composite group is made of, in order."
        }
      },
      "required": [
        "name",
        "joints"
      ],
      "additionalProperties": false
    },
    "JointLimitDeclaration": {
      "type": "object",
      "description": "Limits a package declares for one joint, beyond what its model expresses.",
      "properties": {
        "joint": {
          "type": "string",
          "description": "The joint."
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lower position.",
          "x-unit": "joint"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Upper position.",
          "x-unit": "joint"
        },
        "velocity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum absolute velocity.",
          "x-unit": "joint/s"
        },
        "acceleration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum absolute acceleration.",
          "x-unit": "joint/s^2"
        },
        "effort": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum absolute effort.",
          "x-unit": "joint-effort"
        }
      },
      "required": [
        "joint"
      ],
      "additionalProperties": false
    },
    "Manipulator": {
      "type": "object",
      "description": "A serial arm: a joint group moving ``tool_frame`` relative to ``base_frame``.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Manipulator name, unique within the robot."
        },
        "group": {
          "type": "string",
          "description": "Joint group of the arm, base to tip."
        },
        "base_frame": {
          "type": "string",
          "description": "Frame the arm is mounted at."
        },
        "tool_frame": {
          "type": "string",
          "description": "Frame at the arm's tip, e.g. the flange."
        },
        "end_effector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "End effector at the tip."
        },
        "kinematics": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Kinematics adapter identifier, e.g. 'ssik:ur5e'; opaque to the core."
        }
      },
      "required": [
        "name",
        "group",
        "base_frame",
        "tool_frame"
      ],
      "additionalProperties": false
    },
    "MobileBase": {
      "type": "object",
      "description": "A base commanded by planar twist.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Component name, unique among components."
        },
        "frame": {
          "type": "string",
          "description": "Base frame that twists are expressed in."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joints that model the base's motion, if any."
        }
      },
      "required": [
        "name",
        "frame"
      ],
      "additionalProperties": false
    },
    "ModelEntry": {
      "type": "object",
      "description": "ModelEntry(*, name: 'str', format: 'ModelFormat', path: 'str', srdf: 'str | None' = None)",
      "properties": {
        "name": {
          "type": "string",
          "description": "Model name, unique within the package."
        },
        "format": {
          "type": "string",
          "enum": [
            "ssrobot",
            "mjcf",
            "urdf"
          ],
          "description": "File format."
        },
        "path": {
          "type": "string",
          "description": "File path relative to the package root."
        },
        "srdf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SRDF semantics for a URDF model, relative to the root."
        }
      },
      "required": [
        "name",
        "format",
        "path"
      ],
      "additionalProperties": false
    },
    "NamedConfiguration": {
      "type": "object",
      "description": "Named joint positions for a group, such as 'home' or 'stow'.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Configuration name, unique within the robot."
        },
        "group": {
          "type": "string",
          "description": "Joint group the positions are for."
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "One position per group joint, in group order.",
          "x-unit": "joint"
        }
      },
      "required": [
        "name",
        "group",
        "positions"
      ],
      "additionalProperties": false
    },
    "PackageManifest": {
      "type": "object",
      "description": "The ``ssrobot.toml`` at a package root.",
      "properties": {
        "schema": {
          "const": "ssrobot.package"
        },
        "version": {
          "const": 1
        },
        "robot": {
          "type": "string",
          "description": "Robot name; becomes the description's name."
        },
        "canonical_model": {
          "type": "string",
          "description": "Name of the model the description is built from."
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelEntry"
          },
          "description": "Model files, canonical and alternate."
        },
        "semantics": {
          "$ref": "#/$defs/Semantics",
          "description": "The semantic layer."
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Asset directories models refer to, relative to the root."
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileEntry"
          },
          "description": "Runtime profiles."
        },
        "calibrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "description": "Portable calibration files; machine-local ones stay outside."
        },
        "inference": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opt-in semantic inference; absent means none."
        }
      },
      "required": [
        "schema",
        "version",
        "robot",
        "canonical_model",
        "models"
      ],
      "additionalProperties": false
    },
    "ProfileEntry": {
      "type": "object",
      "description": "A runtime profile, interpreted by the runtime integration it names.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Profile name, unique within the package."
        },
        "runtime": {
          "type": "string",
          "description": "Runtime it configures, e.g. 'mujoco'."
        },
        "path": {
          "type": "string",
          "description": "File path relative to the package root."
        }
      },
      "required": [
        "name",
        "runtime",
        "path"
      ],
      "additionalProperties": false
    },
    "Semantics": {
      "type": "object",
      "description": "The semantic layer of a description, as a package declares it.",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JointGroup"
          },
          "description": "Joint groups."
        },
        "grippers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gripper"
          },
          "description": "Grippers."
        },
        "bases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileBase"
          },
          "description": "Mobile bases."
        },
        "manipulators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Manipulator"
          },
          "description": "Manipulators."
        },
        "end_effectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EndEffector"
          },
          "description": "End effectors and tools."
        },
        "sensors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sensor"
          },
          "description": "Sensors."
        },
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedConfiguration"
          },
          "description": "Named configurations."
        },
        "collision_allowances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollisionAllowance"
          },
          "description": "Static default self-collision exclusions."
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandCapability"
          },
          "description": "Declared command capabilities."
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "description": "Declared observation channels."
        },
        "joint_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JointLimitDeclaration"
          },
          "description": "Joint limits added or tightened beyond the model's."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Sensor": {
      "type": "object",
      "description": "Sensor(*, name: 'str', kind: 'SensorKind', frame: 'str')",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sensor name, unique within the robot."
        },
        "kind": {
          "type": "string",
          "enum": [
            "camera",
            "force_torque"
          ],
          "description": "What the sensor is."
        },
        "frame": {
          "type": "string",
          "description": "Frame the sensor measures in."
        }
      },
      "required": [
        "name",
        "kind",
        "frame"
      ],
      "additionalProperties": false
    }
  }
}
