{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.OffsetGoal v1",
  "$ref": "#/$defs/OffsetGoal",
  "$defs": {
    "OffsetGoal": {
      "type": "object",
      "description": "Move the request's frame in a straight line: ``distance`` along ``direction`` in",
      "properties": {
        "schema": {
          "const": "ssrobot.OffsetGoal"
        },
        "version": {
          "const": 1
        },
        "direction": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Unit direction of motion in the world.",
          "x-unit": "1"
        },
        "distance": {
          "type": "number",
          "description": "How far to move.",
          "x-unit": "m"
        },
        "position_tolerance": {
          "type": "number",
          "description": "Allowed distance from the line and the goal.",
          "x-unit": "m"
        },
        "rotation_tolerance": {
          "type": "number",
          "description": "Allowed rotation from the start orientation, per axis.",
          "x-unit": "rad"
        }
      },
      "required": [
        "schema",
        "version",
        "direction",
        "distance",
        "position_tolerance",
        "rotation_tolerance"
      ],
      "additionalProperties": false
    }
  }
}
