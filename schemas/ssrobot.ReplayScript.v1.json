{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.ReplayScript v1",
  "$ref": "#/$defs/ReplayScript",
  "$defs": {
    "ArrayValue": {
      "type": "object",
      "description": "Dense array such as an image. Stored out of line as a content-addressed asset.",
      "properties": {
        "dtype": {
          "type": "string",
          "enum": [
            "uint8",
            "uint16",
            "int32",
            "float32",
            "float64"
          ]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[0-9a-f]{64}\\.bin$"
        }
      },
      "required": [
        "dtype",
        "shape",
        "sha256",
        "path"
      ],
      "additionalProperties": false
    },
    "BaseTwistCommand": {
      "type": "object",
      "description": "Planar velocity for a mobile base, expressed in the base's own frame.",
      "properties": {
        "schema": {
          "const": "ssrobot.BaseTwistCommand"
        },
        "version": {
          "const": 1
        },
        "base": {
          "type": "string",
          "description": "Mobile base name."
        },
        "linear": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Forward (x) and leftward (y) velocity in the base frame.",
          "x-unit": "m/s"
        },
        "angular": {
          "type": "number",
          "description": "Counter-clockwise yaw rate about base z.",
          "x-unit": "rad/s"
        }
      },
      "required": [
        "schema",
        "version",
        "base",
        "linear",
        "angular"
      ],
      "additionalProperties": false
    },
    "GripperCommand": {
      "type": "object",
      "description": "Target opening for a gripper.",
      "properties": {
        "schema": {
          "const": "ssrobot.GripperCommand"
        },
        "version": {
          "const": 1
        },
        "gripper": {
          "type": "string",
          "description": "Gripper name."
        },
        "opening": {
          "type": "number",
          "description": "0 is fully closed, 1 is fully open.",
          "x-unit": "1"
        }
      },
      "required": [
        "schema",
        "version",
        "gripper",
        "opening"
      ],
      "additionalProperties": false
    },
    "JointCommand": {
      "type": "object",
      "description": "Instantaneous targets for every joint of a group, in the group's declared order.",
      "properties": {
        "schema": {
          "const": "ssrobot.JointCommand"
        },
        "version": {
          "const": 1
        },
        "group": {
          "type": "string",
          "description": "Joint group name."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names; must equal the group's order."
        },
        "mode": {
          "type": "string",
          "enum": [
            "position",
            "velocity",
            "effort"
          ],
          "description": "How values are interpreted."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "One value per joint, in the unit fixed by mode.",
          "x-unit-by": {
            "field": "mode",
            "units": {
              "position": "joint",
              "velocity": "joint/s",
              "effort": "joint-effort"
            }
          }
        }
      },
      "required": [
        "schema",
        "version",
        "group",
        "joints",
        "mode",
        "values"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "position"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "x-unit": "joint"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "velocity"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "x-unit": "joint/s"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "effort"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "x-unit": "joint-effort"
              }
            }
          }
        }
      ]
    },
    "Reading": {
      "type": "object",
      "description": "One channel's value with its own freshness.",
      "properties": {
        "channel": {
          "type": "string",
          "description": "Channel name."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the value was valid, on the runtime clock."
        },
        "value": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "$ref": "#/$defs/ArrayValue"
            }
          ],
          "description": "Flat float64 values for vector quantities, else an array.",
          "x-unit": "channel"
        },
        "source_stamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original device timestamp, when it differs from stamp."
        }
      },
      "required": [
        "channel",
        "stamp",
        "value"
      ],
      "additionalProperties": false
    },
    "ReplayScript": {
      "type": "object",
      "description": "A recording to replay, tick by tick.",
      "properties": {
        "schema": {
          "const": "ssrobot.ReplayScript"
        },
        "version": {
          "const": 1
        },
        "clock": {
          "type": "string",
          "description": "Clock of every timestamp in the recording."
        },
        "ticks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReplayTick"
          },
          "description": "Ticks in strictly increasing time."
        }
      },
      "required": [
        "schema",
        "version",
        "clock",
        "ticks"
      ],
      "additionalProperties": false
    },
    "ReplayTick": {
      "type": "object",
      "description": "What the recording observed at one control tick.",
      "properties": {
        "time_ns": {
          "type": "integer",
          "description": "Runtime time of this tick.",
          "x-unit": "ns"
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reading"
          },
          "description": "Recorded readings, one per channel."
        },
        "expected_applied": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/JointCommand"
                  },
                  {
                    "$ref": "#/$defs/GripperCommand"
                  },
                  {
                    "$ref": "#/$defs/BaseTwistCommand"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Commands the recording applied at this tick; None leaves them unchecked."
        }
      },
      "required": [
        "time_ns",
        "readings"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "object",
      "description": "A point in time on a named clock.",
      "properties": {
        "clock": {
          "type": "string",
          "description": "Clock identity, e.g. 'sim:geodude-1' or 'ros:/clock'."
        },
        "time_ns": {
          "type": "integer",
          "description": "Nanoseconds since the clock's epoch.",
          "x-unit": "ns"
        }
      },
      "required": [
        "clock",
        "time_ns"
      ],
      "additionalProperties": false
    }
  }
}
