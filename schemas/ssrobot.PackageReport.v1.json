{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.PackageReport v1",
  "$ref": "#/$defs/PackageReport",
  "$defs": {
    "Candidate": {
      "type": "object",
      "description": "Candidate(*, id: 'str', kind: 'CandidateKind', rule: 'str', reasons: 'tuple[str, ...]', joints: 'tuple[str, ...]' = (), frame: 'str | None' = None, base_frame: 'str | None' = None, tool_frame: 'str | None' = None, gripper: 'str | None' = None, ambiguity: 'str | None' = None, outcome: 'Outcome' = <Outcome.REPORTED: 'reported'>, name: 'str | None' = None, override: 'str | None' = None)",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier, e.g. 'chain:joint1..joint7'."
        },
        "kind": {
          "type": "string",
          "enum": [
            "chain",
            "gripper",
            "end_effector"
          ],
          "description": "What it would become."
        },
        "rule": {
          "type": "string",
          "description": "The inference rule that produced it."
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The structural evidence."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joints, base to tip."
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gripper or TCP frame."
        },
        "base_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Chain base frame."
        },
        "tool_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Chain tool frame."
        },
        "gripper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gripper candidate an end-effector candidate sits below."
        },
        "ambiguity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Candidates sharing this set exclude one another."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "confirmed",
            "adopted",
            "declared",
            "rejected",
            "not_chosen",
            "ambiguous",
            "reported"
          ],
          "description": "What became of it."
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Name of the adopted entities."
        },
        "override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The manifest override that decided it, if any."
        }
      },
      "required": [
        "id",
        "kind",
        "rule",
        "reasons"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "description": "Why something was rejected, failed, or modified.",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable machine-readable code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected component, if any."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "InferenceReport": {
      "type": "object",
      "description": "Every candidate, the rule behind it, and what became of it.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "report",
            "adopt"
          ],
          "description": "The manifest's inference mode."
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "description": "Candidates in a stable order."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "description": "Ambiguity and missing-evidence findings."
        }
      },
      "required": [
        "mode",
        "candidates"
      ],
      "additionalProperties": false
    },
    "PackageReport": {
      "type": "object",
      "description": "What loading a package resolved: an inspection artifact.",
      "properties": {
        "schema": {
          "const": "ssrobot.PackageReport"
        },
        "version": {
          "const": 1
        },
        "robot": {
          "type": "string",
          "description": "Robot name."
        },
        "canonical_model": {
          "type": "string",
          "description": "Model the description was built from."
        },
        "description": {
          "type": "string",
          "description": "Fingerprint of the loaded description."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedFile"
          },
          "description": "Every resolved file, by role."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceItem"
          },
          "description": "What the canonical model declares that the description does not hold."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "description": "Non-fatal findings: ignored constructs and unresolved ambiguity."
        },
        "inference": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inference candidates and outcomes, when enabled."
        }
      },
      "required": [
        "schema",
        "version",
        "robot",
        "canonical_model",
        "description",
        "files"
      ],
      "additionalProperties": false
    },
    "ResolvedFile": {
      "type": "object",
      "description": "ResolvedFile(*, role: 'str', path: 'str', sha256: 'str')",
      "properties": {
        "role": {
          "type": "string",
          "description": "What the file is, e.g. 'model:mjcf' or 'mesh'."
        },
        "path": {
          "type": "string",
          "description": "Resolved path relative to the package root."
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 of the content; for a directory, of its listing."
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "SourceItem": {
      "type": "object",
      "description": "Something a model file declares that the description deliberately does not hold,",
      "properties": {
        "kind": {
          "type": "string",
          "description": "What it is, e.g. 'actuator' or 'mimic'."
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its name in the source, if any."
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joints, tendons, links, or groups it refers to."
        },
        "detail": {
          "type": "string",
          "description": "Source-specific detail, e.g. the XML tag."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
