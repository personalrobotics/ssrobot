{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.PlanResult v3",
  "$ref": "#/$defs/PlanResult",
  "$defs": {
    "BasePoseGoal": {
      "type": "object",
      "description": "Bring a mobile base's frame to a world pose.",
      "properties": {
        "schema": {
          "const": "ssrobot.BasePoseGoal"
        },
        "version": {
          "const": 1
        },
        "pose": {
          "$ref": "#/$defs/Pose",
          "description": "The base frame's goal pose in the world."
        }
      },
      "required": [
        "schema",
        "version",
        "pose"
      ],
      "additionalProperties": false
    },
    "ConfigurationGoal": {
      "type": "object",
      "description": "Reach any one of these configurations of the request's joints.",
      "properties": {
        "schema": {
          "const": "ssrobot.ConfigurationGoal"
        },
        "version": {
          "const": 1
        },
        "configurations": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "Goal configurations, one value per joint in group order.",
          "x-unit": "joint"
        }
      },
      "required": [
        "schema",
        "version",
        "configurations"
      ],
      "additionalProperties": false
    },
    "Contact": {
      "type": "object",
      "description": "A contact that makes a planning-scene configuration invalid.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "self_collision",
            "robot_environment"
          ],
          "description": "Which rule the contact breaks."
        },
        "first": {
          "type": "string",
          "description": "A description frame, scene object or fixture, or 'world'."
        },
        "second": {
          "type": "string",
          "description": "A description frame, scene object or fixture, or 'world'."
        },
        "distance": {
          "type": "number",
          "description": "Signed distance; negative is penetration.",
          "x-unit": "m"
        }
      },
      "required": [
        "kind",
        "first",
        "second",
        "distance"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "description": "Why something was rejected, failed, or modified.",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable machine-readable code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected component, if any."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "EffectiveLimits": {
      "type": "object",
      "description": "The velocity and acceleration limits a motion must respect: the description's",
      "properties": {
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names, in group order."
        },
        "velocity": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Hardware velocity limit per joint.",
          "x-unit": "joint/s"
        },
        "acceleration": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Hardware acceleration limit per joint.",
          "x-unit": "joint/s^2"
        },
        "velocity_scaling": {
          "type": "number",
          "description": "Factor in (0, 1] on velocity.",
          "x-unit": "1"
        },
        "acceleration_scaling": {
          "type": "number",
          "description": "Factor in (0, 1] on acceleration.",
          "x-unit": "1"
        },
        "effective_velocity": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "velocity times velocity_scaling.",
          "x-unit": "joint/s"
        },
        "effective_acceleration": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "acceleration times acceleration_scaling.",
          "x-unit": "joint/s^2"
        }
      },
      "required": [
        "joints",
        "velocity",
        "acceleration",
        "velocity_scaling",
        "acceleration_scaling",
        "effective_velocity",
        "effective_acceleration"
      ],
      "additionalProperties": false
    },
    "GeometricPath": {
      "type": "object",
      "description": "Waypoints joined by straight joint-space lines, with no timing.",
      "properties": {
        "group": {
          "type": "string",
          "description": "The joint group that moves."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names, in group order."
        },
        "waypoints": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "Configurations, first the start, last the goal.",
          "x-unit": "joint"
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear"
          ],
          "description": "How consecutive waypoints are joined."
        }
      },
      "required": [
        "group",
        "joints",
        "waypoints"
      ],
      "additionalProperties": false
    },
    "InvalidWitness": {
      "type": "object",
      "description": "The first invalid state found, where it is, and why.",
      "properties": {
        "failure": {
          "type": "string",
          "enum": [
            "position_limits",
            "collision",
            "path_constraint",
            "unsupported_motion"
          ],
          "description": "What failed."
        },
        "segment": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Interval index, for a motion or path.",
          "x-unit": "count"
        },
        "fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Position within the interval, 0 to 1.",
          "x-unit": "1"
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time into the trajectory, for a trajectory.",
          "x-unit": "s"
        },
        "configuration": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The first invalid configuration found.",
          "x-unit": "joint"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contact"
          },
          "description": "The disallowed contacts."
        },
        "constraint": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Index of the violated path constraint.",
          "x-unit": "count"
        },
        "detail": {
          "type": "string",
          "description": "A human-readable explanation."
        }
      },
      "required": [
        "failure",
        "configuration"
      ],
      "additionalProperties": false
    },
    "MotionValidation": {
      "type": "object",
      "description": "One validator's answer for one exact subject: valid under the reported policy, or",
      "properties": {
        "schema": {
          "const": "ssrobot.MotionValidation"
        },
        "version": {
          "const": 2
        },
        "subject": {
          "type": "string",
          "enum": [
            "state",
            "motion",
            "path",
            "trajectory"
          ],
          "description": "What was validated."
        },
        "motion": {
          "type": "string",
          "description": "Fingerprint of the exact subject; see *_identity."
        },
        "interpolation": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "linear"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "How a motion or path is interpolated."
        },
        "law": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "piecewise_constant_acceleration"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "A trajectory's law."
        },
        "intervals": {
          "type": "integer",
          "description": "Intervals in the subject: 0 for a state.",
          "x-unit": "count"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "A trajectory's duration.",
          "x-unit": "s"
        },
        "validator": {
          "$ref": "#/$defs/ValidatorIdentity",
          "description": "Who answered, and under what policy."
        },
        "valid": {
          "type": "boolean",
          "description": "Whether the subject is valid under the policy."
        },
        "witness": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvalidWitness"
            },
            {
              "type": "null"
            }
          ],
          "description": "The first invalid state; present exactly when invalid."
        },
        "checks": {
          "type": "integer",
          "description": "State or interval checks performed.",
          "x-unit": "count"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a trajectory validated along its source path, that path's identity (path_identity). Evidence, not part of the subject: the policy says how it is used."
        }
      },
      "required": [
        "schema",
        "version",
        "subject",
        "motion",
        "intervals",
        "validator",
        "valid",
        "checks"
      ],
      "additionalProperties": false
    },
    "OffsetGoal": {
      "type": "object",
      "description": "Move the request's frame in a straight line: ``distance`` along ``direction`` in",
      "properties": {
        "schema": {
          "const": "ssrobot.OffsetGoal"
        },
        "version": {
          "const": 1
        },
        "direction": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Unit direction of motion in the world.",
          "x-unit": "1"
        },
        "distance": {
          "type": "number",
          "description": "How far to move.",
          "x-unit": "m"
        },
        "position_tolerance": {
          "type": "number",
          "description": "Allowed distance from the line and the goal.",
          "x-unit": "m"
        },
        "rotation_tolerance": {
          "type": "number",
          "description": "Allowed rotation from the start orientation, per axis.",
          "x-unit": "rad"
        }
      },
      "required": [
        "schema",
        "version",
        "direction",
        "distance",
        "position_tolerance",
        "rotation_tolerance"
      ],
      "additionalProperties": false
    },
    "PlanResult": {
      "type": "object",
      "description": "A planner's answer to one request, carrying the request itself, so a result is",
      "properties": {
        "schema": {
          "const": "ssrobot.PlanResult"
        },
        "version": {
          "const": 3
        },
        "request": {
          "$ref": "#/$defs/PlanningRequest",
          "description": "The request it answers."
        },
        "planner": {
          "type": "string",
          "description": "Planner name and version."
        },
        "backend": {
          "type": "string",
          "description": "The planner's backend that ran it."
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "infeasible",
            "timeout",
            "cancelled",
            "invalid_input",
            "backend_failure"
          ],
          "description": "How planning ended."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "description": "Why it ended so, with the planner's own messages."
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometricPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The planner's path."
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimedTrajectory"
            },
            {
              "type": "null"
            }
          ],
          "description": "The planner's timed trajectory, if it times motion."
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MotionValidation"
          },
          "description": "The planner's report for the path, then for the trajectory, if any."
        }
      },
      "required": [
        "schema",
        "version",
        "request",
        "planner",
        "backend",
        "status"
      ],
      "additionalProperties": false
    },
    "PlanningRequest": {
      "type": "object",
      "description": "Everything a planner needs, fully resolved: who plans, from where, to what, under",
      "properties": {
        "schema": {
          "const": "ssrobot.PlanningRequest"
        },
        "version": {
          "const": 2
        },
        "robot": {
          "type": "string",
          "description": "Robot name."
        },
        "description": {
          "type": "string",
          "description": "Fingerprint of the robot description."
        },
        "snapshot": {
          "type": "string",
          "description": "Fingerprint of the snapshot it plans in."
        },
        "revision": {
          "type": "integer",
          "description": "The snapshot's scene revision.",
          "x-unit": "count"
        },
        "component": {
          "type": "string",
          "description": "The manipulator or mobile base that moves."
        },
        "group": {
          "type": "string",
          "description": "The joint group that moves."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The group's joints, in order."
        },
        "start": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The joints' positions in the snapshot.",
          "x-unit": "joint"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The frame pose goals and path constraints constrain, if any."
        },
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigurationGoal"
            },
            {
              "$ref": "#/$defs/PoseGoal"
            },
            {
              "$ref": "#/$defs/OffsetGoal"
            },
            {
              "$ref": "#/$defs/TsrGoal"
            },
            {
              "$ref": "#/$defs/BasePoseGoal"
            }
          ],
          "description": "What to reach."
        },
        "path_constraint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tsr"
          },
          "description": "Regions frame must stay inside throughout; all apply."
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "position_limits",
              "collision",
              "tsr_path",
              "velocity_limits",
              "acceleration_limits",
              "effort_limits"
            ]
          },
          "description": "Every constraint class the motion must satisfy, sorted."
        },
        "limits": {
          "$ref": "#/$defs/EffectiveLimits",
          "description": "The velocity and acceleration limits."
        },
        "timeout_s": {
          "type": "number",
          "description": "Planning time budget.",
          "x-unit": "s"
        },
        "seed": {
          "type": "integer",
          "description": "Random seed; equal requests give equal results.",
          "x-unit": "1"
        },
        "clearance_m": {
          "type": "number",
          "description": "Minimum separation the moving robot and its held objects keep from the environment, beyond allowed contacts; see docs/planning.md.",
          "x-unit": "m"
        }
      },
      "required": [
        "schema",
        "version",
        "robot",
        "description",
        "snapshot",
        "revision",
        "component",
        "group",
        "joints",
        "start",
        "frame",
        "goal",
        "constraints",
        "limits",
        "timeout_s",
        "seed"
      ],
      "additionalProperties": false
    },
    "Pose": {
      "type": "object",
      "description": "A rigid transform: the pose of a child frame expressed in a parent frame.",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Child origin in parent coordinates.",
          "x-unit": "m"
        },
        "quat_wxyz": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "Unit quaternion (w, x, y, z) rotating child axes into parent.",
          "x-unit": "1"
        }
      },
      "required": [
        "position",
        "quat_wxyz"
      ],
      "additionalProperties": false
    },
    "PoseGoal": {
      "type": "object",
      "description": "Bring the request's frame to a world pose, within tolerances.",
      "properties": {
        "schema": {
          "const": "ssrobot.PoseGoal"
        },
        "version": {
          "const": 1
        },
        "pose": {
          "$ref": "#/$defs/Pose",
          "description": "The frame's goal pose in the world."
        },
        "position_tolerance": {
          "type": "number",
          "description": "Allowed distance from the goal position.",
          "x-unit": "m"
        },
        "rotation_tolerance": {
          "type": "number",
          "description": "Allowed rotation from the goal orientation, per axis.",
          "x-unit": "rad"
        }
      },
      "required": [
        "schema",
        "version",
        "pose",
        "position_tolerance",
        "rotation_tolerance"
      ],
      "additionalProperties": false
    },
    "Ramp": {
      "type": "object",
      "description": "One joint's motion over a piece: its start state, then constant-acceleration spans.",
      "properties": {
        "position": {
          "type": "number",
          "description": "Position at the piece's start.",
          "x-unit": "joint"
        },
        "velocity": {
          "type": "number",
          "description": "Velocity at the piece's start.",
          "x-unit": "joint/s"
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RampInterval"
          },
          "description": "Consecutive spans."
        }
      },
      "required": [
        "position",
        "velocity",
        "intervals"
      ],
      "additionalProperties": false
    },
    "RampInterval": {
      "type": "object",
      "description": "A span of constant acceleration.",
      "properties": {
        "duration": {
          "type": "number",
          "description": "Length of the span.",
          "x-unit": "s"
        },
        "acceleration": {
          "type": "number",
          "description": "The joint's acceleration.",
          "x-unit": "joint/s^2"
        }
      },
      "required": [
        "duration",
        "acceleration"
      ],
      "additionalProperties": false
    },
    "TimedTrajectory": {
      "type": "object",
      "description": "An exact timed motion from rest to rest: the source law, not a runtime command.",
      "properties": {
        "schema": {
          "const": "ssrobot.TimedTrajectory"
        },
        "version": {
          "const": 2
        },
        "group": {
          "type": "string",
          "description": "The joint group that moves."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names, in group order."
        },
        "law": {
          "type": "string",
          "enum": [
            "piecewise_constant_acceleration"
          ],
          "description": "How position evolves within an interval."
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrajectoryPiece"
          },
          "description": "Consecutive pieces."
        },
        "limits": {
          "$ref": "#/$defs/EffectiveLimits",
          "description": "The limits it was timed and checked under."
        },
        "validated": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "position_limits",
              "collision",
              "tsr_path",
              "velocity_limits",
              "acceleration_limits",
              "effort_limits"
            ]
          },
          "description": "Constraint classes its producer validated, sorted."
        },
        "producer": {
          "type": "string",
          "description": "What produced it, e.g. 'sscbirrt 3.5.0'."
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Producer details as sorted (key, value) pairs."
        }
      },
      "required": [
        "schema",
        "version",
        "group",
        "joints",
        "law",
        "pieces",
        "limits",
        "validated",
        "producer"
      ],
      "additionalProperties": false
    },
    "TrajectoryPiece": {
      "type": "object",
      "description": "An interval in which every joint follows its own ramp, all of one duration.",
      "properties": {
        "validation": {
          "type": "string",
          "enum": [
            "planned",
            "shortcut"
          ],
          "description": "How its geometry was checked."
        },
        "ramps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ramp"
          },
          "description": "One ramp per joint, in joint order."
        }
      },
      "required": [
        "validation",
        "ramps"
      ],
      "additionalProperties": false
    },
    "Tsr": {
      "type": "object",
      "description": "A task space region: the poses ``origin @ T_w @ offset`` with ``T_w`` within the",
      "properties": {
        "origin": {
          "$ref": "#/$defs/Pose",
          "description": "The region frame's pose in the world (T0_w)."
        },
        "offset": {
          "$ref": "#/$defs/Pose",
          "description": "The constrained frame in the region frame (Tw_e)."
        },
        "position_bounds": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "items": false,
          "minItems": 3,
