{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.TraceRecord v1",
  "$ref": "#/$defs/TraceRecord",
  "$defs": {
    "ActionChunk": {
      "type": "object",
      "description": "A sequence of instantaneous command steps at a fixed period, typically from a policy.",
      "properties": {
        "schema": {
          "const": "ssrobot.ActionChunk"
        },
        "version": {
          "const": 1
        },
        "start": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the first step applies."
        },
        "period_ns": {
          "type": "integer",
          "description": "Time between consecutive steps.",
          "x-unit": "ns"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JointCommand"
                },
                {
                  "$ref": "#/$defs/GripperCommand"
                },
                {
                  "$ref": "#/$defs/BaseTwistCommand"
                }
              ]
            }
          },
          "description": "Commands per step; one per addressed component."
        }
      },
      "required": [
        "schema",
        "version",
        "start",
        "period_ns",
        "steps"
      ],
      "additionalProperties": false
    },
    "AppliedCommand": {
      "type": "object",
      "description": "What a runtime actually applied for a command, next to what was requested.",
      "properties": {
        "schema": {
          "const": "ssrobot.AppliedCommand"
        },
        "version": {
          "const": 1
        },
        "execution": {
          "type": "string",
          "description": "Execution identifier."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the command was applied."
        },
        "requested": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointCommand"
            },
            {
              "$ref": "#/$defs/GripperCommand"
            },
            {
              "$ref": "#/$defs/BaseTwistCommand"
            },
            {
              "$ref": "#/$defs/JointTrajectory"
            },
            {
              "$ref": "#/$defs/ActionChunk"
            }
          ],
          "description": "The command as submitted."
        },
        "applied": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointCommand"
            },
            {
              "$ref": "#/$defs/GripperCommand"
            },
            {
              "$ref": "#/$defs/BaseTwistCommand"
            }
          ],
          "description": "The instantaneous command actually applied."
        },
        "modifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modification"
          },
          "description": "Every change between requested and applied; empty if none."
        }
      },
      "required": [
        "schema",
        "version",
        "execution",
        "stamp",
        "requested",
        "applied"
      ],
      "additionalProperties": false
    },
    "ArrayValue": {
      "type": "object",
      "description": "Dense array such as an image. Stored out of line as a content-addressed asset.",
      "properties": {
        "dtype": {
          "type": "string",
          "enum": [
            "uint8",
            "uint16",
            "int32",
            "float32",
            "float64"
          ]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[0-9a-f]{64}\\.bin$"
        }
      },
      "required": [
        "dtype",
        "shape",
        "sha256",
        "path"
      ],
      "additionalProperties": false
    },
    "Attachment": {
      "type": "object",
      "description": "A scene object declared held by an end effector.",
      "properties": {
        "object": {
          "type": "string",
          "description": "The held scene object."
        },
        "end_effector": {
          "type": "string",
          "description": "The end effector holding it."
        },
        "transform": {
          "$ref": "#/$defs/Pose",
          "description": "The object's pose in the end effector's frame."
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Robot frames and scene fixtures the object may touch, sorted."
        },
        "held": {
          "type": "boolean",
          "description": "False once the runtime reported the object left the grasp."
        }
      },
      "required": [
        "object",
        "end_effector",
        "transform",
        "allow"
      ],
      "additionalProperties": false
    },
    "AttachmentViolation": {
      "type": "object",
      "description": "A runtime's report that an attached object left its declared transform.",
      "properties": {
        "schema": {
          "const": "ssrobot.AttachmentViolation"
        },
        "version": {
          "const": 1
        },
        "object": {
          "type": "string",
          "description": "The attached object."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the tolerance was first exceeded."
        },
        "position_error": {
          "type": "number",
          "description": "Distance from the declared position.",
          "x-unit": "m"
        },
        "rotation_error": {
          "type": "number",
          "description": "Angle from the declared orientation.",
          "x-unit": "rad"
        }
      },
      "required": [
        "schema",
        "version",
        "object",
        "stamp",
        "position_error",
        "rotation_error"
      ],
      "additionalProperties": false
    },
    "BaseTwistCommand": {
      "type": "object",
      "description": "Planar velocity for a mobile base, expressed in the base's own frame.",
      "properties": {
        "schema": {
          "const": "ssrobot.BaseTwistCommand"
        },
        "version": {
          "const": 1
        },
        "base": {
          "type": "string",
          "description": "Mobile base name."
        },
        "linear": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Forward (x) and leftward (y) velocity in the base frame.",
          "x-unit": "m/s"
        },
        "angular": {
          "type": "number",
          "description": "Counter-clockwise yaw rate about base z.",
          "x-unit": "rad/s"
        }
      },
      "required": [
        "schema",
        "version",
        "base",
        "linear",
        "angular"
      ],
      "additionalProperties": false
    },
    "CommandCapability": {
      "type": "object",
      "description": "A command a component accepts.",
      "properties": {
        "component": {
          "type": "string",
          "description": "Component name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "joint",
            "joint_trajectory",
            "gripper",
            "base_twist"
          ],
          "description": "Accepted command kind."
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "position",
                "velocity",
                "effort"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Joint mode; JOINT kind only."
        }
      },
      "required": [
        "component",
        "kind"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "description": "Why something was rejected, failed, or modified.",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable machine-readable code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected component, if any."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ExecutionStatus": {
      "type": "object",
      "description": "The state of one submitted command at a point in runtime time.",
      "properties": {
        "schema": {
          "const": "ssrobot.ExecutionStatus"
        },
        "version": {
          "const": 1
        },
        "execution": {
          "type": "string",
          "description": "Execution identifier, unique within a context."
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "succeeded",
            "canceled",
            "timed_out",
            "rejected",
            "failed"
          ],
          "description": "Current state."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When this state was observed."
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostic"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for rejected, timed-out, and failed states."
        }
      },
      "required": [
        "schema",
        "version",
        "execution",
        "state",
        "stamp"
      ],
      "additionalProperties": false
    },
    "GripperCommand": {
      "type": "object",
      "description": "Target opening for a gripper.",
      "properties": {
        "schema": {
          "const": "ssrobot.GripperCommand"
        },
        "version": {
          "const": 1
        },
        "gripper": {
          "type": "string",
          "description": "Gripper name."
        },
        "opening": {
          "type": "number",
          "description": "0 is fully closed, 1 is fully open.",
          "x-unit": "1"
        }
      },
      "required": [
        "schema",
        "version",
        "gripper",
        "opening"
      ],
      "additionalProperties": false
    },
    "JointCommand": {
      "type": "object",
      "description": "Instantaneous targets for every joint of a group, in the group's declared order.",
      "properties": {
        "schema": {
          "const": "ssrobot.JointCommand"
        },
        "version": {
          "const": 1
        },
        "group": {
          "type": "string",
          "description": "Joint group name."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names; must equal the group's order."
        },
        "mode": {
          "type": "string",
          "enum": [
            "position",
            "velocity",
            "effort"
          ],
          "description": "How values are interpreted."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "One value per joint, in the unit fixed by mode.",
          "x-unit-by": {
            "field": "mode",
            "units": {
              "position": "joint",
              "velocity": "joint/s",
              "effort": "joint-effort"
            }
          }
        }
      },
      "required": [
        "schema",
        "version",
        "group",
        "joints",
        "mode",
        "values"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "position"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "x-unit": "joint"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "velocity"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "x-unit": "joint/s"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "effort"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "x-unit": "joint-effort"
              }
            }
          }
        }
      ]
    },
    "JointTrajectory": {
      "type": "object",
      "description": "Timed joint positions for a group, executed from the time it starts.",
      "properties": {
        "schema": {
          "const": "ssrobot.JointTrajectory"
        },
        "version": {
          "const": 1
        },
        "group": {
          "type": "string",
          "description": "Joint group name."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names; must equal the group's order."
        },
        "time_from_start_ns": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Waypoint times; start at 0 and strictly increase.",
          "x-unit": "ns"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "One row of joint positions per waypoint.",
          "x-unit": "joint"
        },
        "velocities": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional row of joint velocities per waypoint.",
          "x-unit": "joint/s"
        }
      },
      "required": [
        "schema",
        "version",
        "group",
        "joints",
        "time_from_start_ns",
        "positions"
      ],
      "additionalProperties": false
    },
    "Modification": {
      "type": "object",
      "description": "Modification(*, kind: 'ModificationKind', target: 'str', detail: 'str' = '')",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "clipped",
            "rate_limited",
            "safety_override"
          ],
          "description": "What the runtime changed."
        },
        "target": {
          "type": "string",
          "description": "Affected joint, component, or field."
        },
        "detail": {
          "type": "string",
          "description": "Human-readable detail."
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    "ObjectState": {
      "type": "object",
      "description": "A scene object's pose in the world.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Scene object name."
        },
        "pose": {
          "$ref": "#/$defs/Pose",
          "description": "The object's pose in the world frame."
        }
      },
      "required": [
        "name",
        "pose"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "description": "A set of readings assembled at one runtime time.",
      "properties": {
        "schema": {
          "const": "ssrobot.Observation"
        },
        "version": {
          "const": 1
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the observation was assembled."
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reading"
          },
          "description": "One reading per requested channel."
        }
      },
      "required": [
        "schema",
        "version",
        "stamp",
        "readings"
      ],
      "additionalProperties": false
    },
    "Pose": {
      "type": "object",
      "description": "A rigid transform: the pose of a child frame expressed in a parent frame.",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Child origin in parent coordinates.",
          "x-unit": "m"
        },
        "quat_wxyz": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "Unit quaternion (w, x, y, z) rotating child axes into parent.",
          "x-unit": "1"
        }
      },
      "required": [
        "position",
        "quat_wxyz"
      ],
      "additionalProperties": false
    },
    "Reading": {
      "type": "object",
      "description": "One channel's value with its own freshness.",
      "properties": {
        "channel": {
          "type": "string",
          "description": "Channel name."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the value was valid, on the runtime clock."
        },
        "value": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "$ref": "#/$defs/ArrayValue"
            }
          ],
          "description": "Flat float64 values for vector quantities, else an array.",
          "x-unit": "channel"
        },
        "source_stamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original device timestamp, when it differs from stamp."
        }
      },
      "required": [
        "channel",
        "stamp",
        "value"
      ],
      "additionalProperties": false
    },
    "RuntimeHealth": {
      "type": "object",
      "description": "A runtime's report that it faulted or recovered.",
      "properties": {
        "schema": {
          "const": "ssrobot.RuntimeHealth"
        },
        "version": {
          "const": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "faulted"
          ],
          "description": "Health after this report."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the change happened, on the runtime clock."
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostic"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required when faulted."
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Affected components; empty means the whole robot."
        }
      },
      "required": [
        "schema",
        "version",
        "state",
        "stamp"
      ],
      "additionalProperties": false
    },
    "RuntimeInfo": {
      "type": "object",
      "description": "What an opened runtime reports about itself.",
      "properties": {
        "schema": {
          "const": "ssrobot.RuntimeInfo"
        },
        "version": {
          "const": 1
        },
        "runtime": {
          "type": "string",
          "description": "Runtime implementation name."
        },
        "runtime_version": {
          "type": "string",
          "description": "Runtime implementation and backend versions."
        },
        "clock_mode": {
          "type": "string",
          "enum": [
            "manual",
            "external"
          ],
          "description": "Who advances time."
        },
        "clock": {
          "type": "string",
          "description": "Clock identity used by every timestamp it produces."
        },
        "description": {
          "type": "string",
          "description": "Fingerprint of the bound robot description."
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandCapability"
          },
          "description": "Command capabilities confirmed available now."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Channel names confirmed available now."
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scene objects that can be attached, sorted; empty without a scene."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Static scene bodies an attachment may allow contact with, sorted."
        }
      },
      "required": [
        "schema",
        "version",
        "runtime",
        "runtime_version",
        "clock_mode",
        "clock",
        "description",
        "commands",
        "channels"
      ],
      "additionalProperties": false
    },
    "SceneSnapshot": {
      "type": "object",
      "description": "An immutable copy of everything a geometric query reads: the robot's joint",
      "properties": {
        "schema": {
          "const": "ssrobot.SceneSnapshot"
        },
        "version": {
          "const": 1
        },
        "description": {
          "type": "string",
          "description": "Fingerprint of the robot description."
        },
        "runtime": {
          "type": "string",
          "description": "Name of the runtime that captured it."
        },
        "model": {
          "type": "string",
          "description": "The runtime's identity for the simulated world; opaque to the core."
        },
        "stamp": {
          "$ref": "#/$defs/Timestamp",
          "description": "When it was captured, on the runtime clock."
        },
        "revision": {
          "type": "integer",
          "description": "Scene revision it was captured at.",
          "x-unit": "count"
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every description joint, in order."
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Each joint's position, in the order of joints.",
          "x-unit": "joint"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectState"
          },
          "description": "Every scene object's pose, sorted by name."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scene fixtures, sorted."
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "description": "Declared attachments, sorted by object."
        }
      },
      "required": [
        "schema",
        "version",
        "description",
        "runtime",
        "model",
        "stamp",
        "revision",
        "joints",
        "positions"
      ],
      "additionalProperties": false
    },
    "SceneState": {
      "type": "object",
      "description": "A context's scene: the objects it can hold and what it holds now.",
      "properties": {
        "schema": {
          "const": "ssrobot.SceneState"
        },
        "version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "description": "Increments on every change, from 0 when the context opens.",
          "x-unit": "count"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scene objects that can be attached, sorted."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Static scene bodies an attachment may allow contact with, sorted."
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "description": "Current attachments, sorted by object."
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "objects",
        "fixtures"
      ],
      "additionalProperties": false
    },
    "Submission": {
      "type": "object",
      "description": "A command accepted by a context for execution, with its source and deadline.",
      "properties": {
        "schema": {
          "const": "ssrobot.Submission"
        },
        "version": {
          "const": 1
        },
        "execution": {
          "type": "string",
          "description": "Execution identifier assigned by the context."
        },
        "source": {
          "type": "string",
          "description": "Who submitted it, e.g. 'planner' or 'policy:act'."
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointCommand"
            },
            {
              "$ref": "#/$defs/GripperCommand"
            },
            {
              "$ref": "#/$defs/BaseTwistCommand"
            },
            {
              "$ref": "#/$defs/JointTrajectory"
            },
            {
              "$ref": "#/$defs/ActionChunk"
            }
          ],
          "description": "The submitted command."
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runtime time by which it must finish, else it times out."
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fingerprint of the snapshot the command was planned on, if given."
        }
      },
      "required": [
        "schema",
        "version",
        "execution",
        "source",
        "command"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "object",
      "description": "A point in time on a named clock.",
      "properties": {
        "clock": {
          "type": "string",
          "description": "Clock identity, e.g. 'sim:geodude-1' or 'ros:/clock'."
        },
        "time_ns": {
          "type": "integer",
          "description": "Nanoseconds since the clock's epoch.",
          "x-unit": "ns"
        }
      },
      "required": [
        "clock",
        "time_ns"
      ],
      "additionalProperties": false
    },
    "TraceRecord": {
      "type": "object",
      "description": "One event in a context's life, in causal order.",
      "properties": {
        "schema": {
          "const": "ssrobot.TraceRecord"
        },
        "version": {
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "description": "Position in the trace, from 0.",
          "x-unit": "count"
        },
        "kind": {
          "type": "string",
          "enum": [
            "opened",
            "observed",
            "submitted",
            "status",
            "applied",
            "health",
            "scene",
            "snapshot",
            "violation",
            "stepped",
            "closed"
          ],
          "description": "What happened."
        },
        "clock": {
          "type": "string",
          "description": "Clock of time_ns: the runtime clock."
        },
        "time_ns": {
          "type": "integer",
          "description": "Runtime time of the event.",
          "x-unit": "ns"
        },
        "source": {
          "type": "string",
          "description": "Who caused it: a submitter, 'context', or 'runtime:<name>'."
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeInfo"
            },
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "$ref": "#/$defs/Submission"
            },
            {
              "$ref": "#/$defs/ExecutionStatus"
            },
            {
              "$ref": "#/$defs/AppliedCommand"
            },
            {
              "$ref": "#/$defs/RuntimeHealth"
            },
            {
              "$ref": "#/$defs/SceneState"
            },
            {
              "$ref": "#/$defs/AttachmentViolation"
            },
            {
              "$ref": "#/$defs/SceneSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "Event detail, by kind."
        }
      },
      "required": [
        "schema",
        "version",
        "sequence",
        "kind",
        "clock",
        "time_ns",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
