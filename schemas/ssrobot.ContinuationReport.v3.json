{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.ContinuationReport v3",
  "$ref": "#/$defs/ContinuationReport",
  "$defs": {
    "ContinuationReport": {
      "type": "object",
      "description": "Whether a continuation ran, and the evidence for that decision.",
      "properties": {
        "schema": {
          "const": "ssrobot.ContinuationReport"
        },
        "version": {
          "const": 3
        },
        "prediction": {
          "type": "string",
          "description": "Fingerprint of the prediction it was planned on."
        },
        "source": {
          "type": "string",
          "description": "The source execution's identifier."
        },
        "plan": {
          "type": "string",
          "description": "Fingerprint of the plan made on the prediction."
        },
        "actual": {
          "type": "string",
          "description": "Fingerprint of the captured arrival state."
        },
        "accepted": {
          "type": "boolean",
          "description": "Whether the continuation was submitted."
        },
        "refusal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The refusal's code, if refused."
        },
        "detail": {
          "type": "string",
          "description": "Why, in words."
        },
        "predicted_start": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The plan's start, from the prediction.",
          "x-unit": "joint"
        },
        "actual_start": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The commanded joints at arrival.",
          "x-unit": "joint"
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Discrepancy"
          },
          "description": "Every checked quantity outside its tolerance."
        },
        "max_start_gap": {
          "type": "number",
          "description": "The largest gap between the predicted and actual start.",
          "x-unit": "joint"
        },
        "arrival_tolerance": {
          "type": "number",
          "description": "The arrival tolerance.",
          "x-unit": "joint"
        },
        "rest_tolerance": {
          "type": "number",
          "description": "The most a joint may still move, per second.",
          "x-unit": "joint"
        },
        "object_tolerance_m": {
          "type": "number",
          "description": "How far a free object may have moved.",
          "x-unit": "m"
        },
        "object_tolerance_rad": {
          "type": "number",
          "description": "How far a free object may have turned.",
          "x-unit": "rad"
        },
        "rest": {
          "type": "string",
          "description": "How rest was established."
        },
        "rest_stamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the joint-velocity reading that established rest was valid: never before the arrival snapshot."
        },
        "rebase": {
          "type": "string",
          "description": "The planner's account of its rebase: any bridge or change."
        },
        "rebased_plan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fingerprint of the rebased plan, if there is one."
        },
        "prepared": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fingerprint of the compiled PreparedTrajectory, if any."
        },
        "execution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The continuation's execution identifier, if submitted."
        }
      },
      "required": [
        "schema",
        "version",
        "prediction",
        "source",
        "plan",
        "actual",
        "accepted",
        "predicted_start",
        "actual_start",
        "max_start_gap",
        "arrival_tolerance",
        "rest_tolerance",
        "object_tolerance_m",
        "object_tolerance_rad"
      ],
      "additionalProperties": false
    },
    "Discrepancy": {
      "type": "object",
      "description": "One way the actual state differs from the prediction.",
      "properties": {
        "what": {
          "type": "string",
          "description": "A joint, an object or its rotation, or 'revision'."
        },
        "predicted": {
          "type": "number",
          "description": "The predicted value.",
          "x-unit": "1"
        },
        "actual": {
          "type": "number",
          "description": "The actual value.",
          "x-unit": "1"
        },
        "tolerance": {
          "type": "number",
          "description": "The tolerance it was held to.",
          "x-unit": "1"
        }
      },
      "required": [
        "what",
        "predicted",
        "actual",
        "tolerance"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "object",
      "description": "A point in time on a named clock.",
      "properties": {
        "clock": {
          "type": "string",
          "description": "Clock identity, e.g. 'sim:geodude-1' or 'ros:/clock'."
        },
        "time_ns": {
          "type": "integer",
          "description": "Nanoseconds since the clock's epoch.",
          "x-unit": "ns"
        }
      },
      "required": [
        "clock",
        "time_ns"
      ],
      "additionalProperties": false
    }
  }
}
