{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.GuardedJointTrajectory v3",
  "$ref": "#/$defs/GuardedJointTrajectory",
  "$defs": {
    "EffortGuard": {
      "type": "object",
      "description": "A joint-effort condition a runtime evaluates at every control tick.",
      "properties": {
        "schema": {
          "const": "ssrobot.EffortGuard"
        },
        "version": {
          "const": 1
        },
        "channel": {
          "type": "string",
          "description": "The joint-effort channel it reads."
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Per joint, in the channel's group's canonical order, the effort change that trips the guard.",
          "x-unit": "joint-effort"
        },
        "tare": {
          "type": "boolean",
          "description": "Measure from the reading when the motion started."
        },
        "samples": {
          "type": "integer",
          "description": "Consecutive ticks at or over a threshold.",
          "x-unit": "count"
        }
      },
      "required": [
        "schema",
        "version",
        "channel",
        "thresholds"
      ],
      "additionalProperties": false
    },
    "GuardedJointTrajectory": {
      "type": "object",
      "description": "A ``JointTrajectory`` executed as usual until its guard triggers. The runtime then",
      "properties": {
        "schema": {
          "const": "ssrobot.GuardedJointTrajectory"
        },
        "version": {
          "const": 3
        },
        "trajectory": {
          "$ref": "#/$defs/JointTrajectory",
          "description": "The motion to execute."
        },
        "guard": {
          "anyOf": [
            {
              "$ref": "#/$defs/WrenchGuard"
            },
            {
              "$ref": "#/$defs/OpeningGuard"
            },
            {
              "$ref": "#/$defs/EffortGuard"
            }
          ],
          "description": "When to stop it."
        }
      },
      "required": [
        "schema",
        "version",
        "trajectory",
        "guard"
      ],
      "additionalProperties": false
    },
    "JointTrajectory": {
      "type": "object",
      "description": "Timed joint positions for a group, executed from the time it starts.",
      "properties": {
        "schema": {
          "const": "ssrobot.JointTrajectory"
        },
        "version": {
          "const": 1
        },
        "group": {
          "type": "string",
          "description": "Joint group name."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Joint names; must equal the group's order."
        },
        "time_from_start_ns": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Waypoint times; start at 0 and strictly increase.",
          "x-unit": "ns"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "One row of joint positions per waypoint.",
          "x-unit": "joint"
        },
        "velocities": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional row of joint velocities per waypoint.",
          "x-unit": "joint/s"
        }
      },
      "required": [
        "schema",
        "version",
        "group",
        "joints",
        "time_from_start_ns",
        "positions"
      ],
      "additionalProperties": false
    },
    "OpeningGuard": {
      "type": "object",
      "description": "A gripper-opening condition a runtime evaluates at every control tick.",
      "properties": {
        "schema": {
          "const": "ssrobot.OpeningGuard"
        },
        "version": {
          "const": 1
        },
        "channel": {
          "type": "string",
          "description": "The gripper-opening channel it reads."
        },
        "below": {
          "type": "number",
          "description": "Trigger when the opening is below this.",
          "x-unit": "1"
        },
        "samples": {
          "type": "integer",
          "description": "Consecutive ticks below the bound.",
          "x-unit": "count"
        }
      },
      "required": [
        "schema",
        "version",
        "channel",
        "below"
      ],
      "additionalProperties": false
    },
    "WrenchGuard": {
      "type": "object",
      "description": "A force-torque condition a runtime evaluates at every control tick.",
      "properties": {
        "schema": {
          "const": "ssrobot.WrenchGuard"
        },
        "version": {
          "const": 1
        },
        "channel": {
          "type": "string",
          "description": "The wrench channel it reads."
        },
        "part": {
          "type": "string",
          "enum": [
            "force",
            "torque"
          ],
          "description": "Force or torque."
        },
        "axis": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ],
          "description": "Unit axis in the sensor frame to project onto; None for the magnitude.",
          "x-unit": "1"
        },
        "threshold": {
          "type": "number",
          "description": "Trigger when the measure reaches this.",
          "x-unit-by": {
            "field": "part",
            "units": {
              "force": "N",
              "torque": "N*m"
            }
          }
        },
        "tare": {
          "type": "boolean",
          "description": "Measure from the reading when the motion started."
        },
        "samples": {
          "type": "integer",
          "description": "Consecutive ticks at or over the threshold.",
          "x-unit": "count"
        }
      },
      "required": [
        "schema",
        "version",
        "channel",
        "part",
        "threshold"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "part": {
                "const": "force"
              }
            },
            "required": [
              "part"
            ]
          },
          "then": {
            "properties": {
              "threshold": {
                "x-unit": "N"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "part": {
                "const": "torque"
              }
            },
            "required": [
              "part"
            ]
          },
          "then": {
            "properties": {
              "threshold": {
                "x-unit": "N*m"
              }
            }
          }
        }
      ]
    }
  }
}
