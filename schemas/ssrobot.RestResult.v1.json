{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssrobot.RestResult v1",
  "$ref": "#/$defs/RestResult",
  "$defs": {
    "JointRest": {
      "type": "object",
      "description": "A joint group, or another component's joints, comes to rest: judged on the",
      "properties": {
        "schema": {
          "const": "ssrobot.JointRest"
        },
        "version": {
          "const": 1
        },
        "component": {
          "type": "string",
          "description": "The component whose joints are judged."
        },
        "criteria": {
          "anyOf": [
            {
              "$ref": "#/$defs/RestCriteria"
            },
            {
              "type": "null"
            }
          ],
          "description": "The criteria to judge by; None for those the channel's runtime declares."
        }
      },
      "required": [
        "schema",
        "version",
        "component"
      ],
      "additionalProperties": false
    },
    "ObjectRest": {
      "type": "object",
      "description": "A scene object comes to rest: judged on the declared pose channel whose source is",
      "properties": {
        "schema": {
          "const": "ssrobot.ObjectRest"
        },
        "version": {
          "const": 1
        },
        "object": {
          "type": "string",
          "description": "The scene object whose pose is judged."
        },
        "criteria": {
          "anyOf": [
            {
              "$ref": "#/$defs/RestCriteria"
            },
            {
              "type": "null"
            }
          ],
          "description": "The criteria to judge by; None for those the channel's runtime declares."
        }
      },
      "required": [
        "schema",
        "version",
        "object"
      ],
      "additionalProperties": false
    },
    "RestChannel": {
      "type": "object",
      "description": "The channel a watch judged, and who produced it.",
      "properties": {
        "channel": {
          "type": "string",
          "description": "Channel name."
        },
        "quantity": {
          "type": "string",
          "enum": [
            "joint_position",
            "joint_velocity",
            "joint_effort",
            "gripper_opening",
            "pose",
            "wrench",
            "rgb_image",
            "depth_image",
            "contact"
          ],
          "description": "What it measures."
        },
        "observed": {
          "type": "string",
          "description": "The entity it observes: a component or an object."
        },
        "runtime": {
          "type": "string",
          "description": "The runtime that sourced its readings."
        },
        "privileged": {
          "type": "boolean",
          "description": "Whether its readings are privileged simulator truth."
        }
      },
      "required": [
        "channel",
        "quantity",
        "observed",
        "runtime",
        "privileged"
      ],
      "additionalProperties": false
    },
    "RestCriteria": {
      "type": "object",
      "description": "When a channel's readings count as at rest: declared by the runtime that sources the",
      "properties": {
        "max_gap_ns": {
          "type": "integer",
          "description": "The largest spacing between samples still treated as continuous.",
          "x-unit": "ns"
        },
        "dwell_ns": {
          "type": "integer",
          "description": "How long the readings must stay within bounds.",
          "x-unit": "ns"
        },
        "variation": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The most each element's range may be over the dwell, one bound per element of the channel; joint-position channels only.",
          "x-unit": "channel"
        },
        "translation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The most each position coordinate's range may be over the dwell; pose only.",
          "x-unit": "m"
        },
        "rotation_rad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The largest angle any orientation may be from the dwell's first; pose only.",
          "x-unit": "rad"
        },
        "source": {
          "type": "string",
          "description": "Where the values come from: a datasheet, a driver, or a measurement."
        }
      },
      "required": [
        "max_gap_ns",
        "dwell_ns",
        "source"
      ],
      "additionalProperties": false
    },
    "RestResult": {
      "type": "object",
      "description": "How a rest watch ended, and the readings that justify it.",
      "properties": {
        "schema": {
          "const": "ssrobot.RestResult"
        },
        "version": {
          "const": 1
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointRest"
            },
            {
              "$ref": "#/$defs/ObjectRest"
            }
          ],
          "description": "What was watched, as asked."
        },
        "channel": {
          "$ref": "#/$defs/RestChannel",
          "description": "The channel it was judged on."
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The name of each value of a sample: the channel's joints, or x..qz."
        },
        "judged": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The elements held to the criteria: the component's joints, or all."
        },
        "criteria": {
          "$ref": "#/$defs/RestCriteria",
          "description": "The criteria it was judged by."
        },
        "start": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the watch started."
        },
        "end": {
          "$ref": "#/$defs/Timestamp",
          "description": "When it ended."
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp",
          "description": "The caller's deadline."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "at_rest",
            "deadline",
            "unavailable",
            "malformed",
            "canceled"
          ],
          "description": "How it ended."
        },
        "detail": {
          "type": "string",
          "description": "Why, in words."
        },
        "samples": {
          "type": "integer",
          "description": "How many readings it judged.",
          "x-unit": "count"
        },
        "window": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RestSample"
          },
          "description": "At rest: the samples, spanning the dwell, that justify it; else empty."
        },
        "preceding": {
          "anyOf": [
            {
              "$ref": "#/$defs/RestSample"
            },
            {
              "type": "null"
            }
          ],
          "description": "At rest: the sample just before the window, continuous with it, that breaks the bound with it; None when the window starts the watch or follows a gap."
        },
        "longest": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RestSample"
          },
          "description": "Otherwise: the longest continuous run within the bound it saw."
        }
      },
      "required": [
        "schema",
        "version",
        "condition",
        "channel",
        "elements",
        "judged",
        "criteria",
        "start",
        "end",
        "deadline",
        "outcome",
        "samples"
      ],
      "additionalProperties": false
    },
    "RestSample": {
      "type": "object",
      "description": "One reading a watch judged.",
      "properties": {
        "time_ns": {
          "type": "integer",
          "description": "When the reading was valid, on the clock.",
          "x-unit": "ns"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The reading's values.",
          "x-unit": "channel"
        }
      },
      "required": [
        "time_ns",
        "value"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "object",
      "description": "A point in time on a named clock.",
      "properties": {
        "clock": {
          "type": "string",
          "description": "Clock identity, e.g. 'sim:geodude-1' or 'ros:/clock'."
        },
        "time_ns": {
          "type": "integer",
          "description": "Nanoseconds since the clock's epoch.",
          "x-unit": "ns"
        }
      },
      "required": [
        "clock",
        "time_ns"
      ],
      "additionalProperties": false
    }
  }
}
