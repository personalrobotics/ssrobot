<!-- The two-robot planning proof's scene for geodude (#24): a cylinder 4 cm across and
     12 cm tall, standing on Geodude's own worktable (top at z = 0.754 m) within the arm's
     reach. MujocoRuntime(package, scene=...) composes it with the robot: "cylinder" has a
     free joint, so it is an object. -->
<mujoco model="geodude-cylinder">
  <worldbody>
    <body name="cylinder" pos="0.35 -0.35 0.814">
      <freejoint/>
      <geom type="cylinder" size="0.02 0.06" mass="0.1" rgba="0.2 0.4 0.8 1"/>
    </body>
  </worldbody>
</mujoco>
